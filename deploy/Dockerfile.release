# Release image built from the binaries the release workflow already compiled,
# one per platform: docker buildx build --platform linux/<arch> -f deploy/Dockerfile.release dist/bin
FROM alpine:3.22
ARG TARGETARCH
RUN apk add --no-cache ca-certificates tzdata && adduser -D -H -u 10001 zirox && mkdir /data && chown zirox /data
COPY zirox-linux-${TARGETARCH} /usr/local/bin/zirox
USER zirox
ENV ZIROX_DATA_DIR=/data ZIROX_LISTEN=:9116
VOLUME /data
EXPOSE 9116
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1:9116/healthz || exit 1
ENTRYPOINT ["/usr/local/bin/zirox"]
